rules_version = '2';

// j+k adventures. Nobody reads or writes Firestore from a browser.
// The website's server (site/_worker.js) uses the service account, which these rules do not apply to,
// and hands each signed-in person only their own details through /api/account.
// Paste this into Firebase console > Firestore Database > Rules, then Publish (docs/setup/firebase.md).
service cloud.firestore {
  match /databases/{database}/documents {
    // the shop's open sign (settings/shop) and the Square links (settings/square_production,
    // settings/square_sandbox). Only the server reads them; only the owner, through /admin, changes them.
    match /settings/{doc} {
      allow read, write: if false;
    }

    // the available switches (settings/available_<mode>) live here too. the "i'm interested" tallies and
    // their scrambled vote records (interest_<mode>, interest_votes_<mode>, interest_ips_<mode>) fall under
    // the rule below: only the server counts votes, so nobody can add to a tally from a browser.
    // the same goes for "email me when it's here" (notify_<mode>, notify_ips_<mode>) and the daily email count
    // (email_days): addresses are only ever read by the server.

    // customers, their order notes, reviews and everything else: server only
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
