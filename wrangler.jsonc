{
  // Cloudflare Worker that serves the site and runs /api/checkout.
  // "name" must match the Worker's name in your Cloudflare dashboard.
  "name": "ourjkadventures",
  "main": "site/_worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  // the KV drawer for the instagram key and the saved reels (docs/setup/instagram.md, step 3).
  // when the owner has created REEL_STORE, replace this comment with:
  //   "kv_namespaces": [{ "binding": "REEL_STORE", "id": "<the namespace id>" }],
  // until then /api/reels answers "not connected" and the About page shows its stand-in reels.
  "observability": { "enabled": true },
  "keep_vars": true
}
