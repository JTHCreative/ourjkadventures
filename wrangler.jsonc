{
  // Cloudflare Worker that serves the site and runs /api/checkout.
  // "name" must match the Worker's name in your Cloudflare dashboard.
  "name": "ourjkadventures",
  "main": "site/_worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  // the KV drawer for the instagram key and the saved reels (docs/setup/instagram.md, step 3)
  "kv_namespaces": [{ "binding": "REEL_STORE", "id": "09a672c7570c4bea8b4584e92c287bbb" }],
  // @ourjkadventures' Instagram account ID (not secret): Meta's key doesn't say which account was shared
  "vars": { "INSTAGRAM_ACCOUNT_ID": "1323062497557751" },
  "observability": { "enabled": true },
  "keep_vars": true
}
