# copy to .dev.vars (gitignored) for local testing with `npx wrangler dev`
SQUARE_ACCESS_TOKEN=your-sandbox-token
SQUARE_LOCATION_ID=your-sandbox-location-id
SQUARE_ENV=sandbox
TAX_PERCENT=
SUPPORT_EMAIL=support@ourjkadventures.com
# phase 2
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
# phase 3
FIREBASE_PROJECT_ID=jk-adventures-website
FIREBASE_SERVICE_ACCOUNT=
# who may use /admin, comma separated
ADMIN_EMAILS=ourjkadventures@gmail.com
# the About page's reels (docs/setup/instagram.md). REEL_STORE is a KV binding in wrangler.jsonc, not a variable
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
