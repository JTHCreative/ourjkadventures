# copy to .dev.vars (gitignored) for local testing with `npx wrangler dev`
SQUARE_ACCESS_TOKEN=your-sandbox-token
SQUARE_LOCATION_ID=your-sandbox-location-id
SQUARE_ENV=sandbox
# the checkout page's embedded card form: your Square app's Application ID (sandbox-sq0idb-... while testing)
SQUARE_APPLICATION_ID=
SUPPORT_EMAIL=support@ourjkadventures.com
# phase 2
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
# phase 3
FIREBASE_PROJECT_ID=jk-adventures-website
FIREBASE_SERVICE_ACCOUNT=
# who may use /admin, comma separated
ADMIN_EMAILS=ourjkadventures@gmail.com
# the About page's reels (docs/setup/instagram.md). REEL_STORE is a KV binding and INSTAGRAM_PAGE_ID a var, both in wrangler.jsonc
INSTAGRAM_ACCESS_TOKEN=
META_APP_SECRET=
# optional: only for the "key" line in /admin's test answers
META_APP_ID=
# "email me when it's here" (docs/setup/email.md). leave the key empty and the site just doesn't offer it.
# careful: a real key sends real email, even locally
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_DAILY_LIMIT=
